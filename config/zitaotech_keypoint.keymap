#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define RESERVE 4
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    macros {
        lm: lm {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_press>,
                <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
                <&macro_release>,
                <&mo MACRO_PLACEHOLDER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB             &kp Q             &kp W               &kp E       &kp R        &kp T        &kp Y      &kp U      &kp I           &kp O         &kp P  &none
&mt LEFT_WIN GRAVE  &kp A             &kp S               &kp D       &kp F        &kp G        &mkp LCLK  &mkp LCLK  &kp H           &kp J         &kp K  &kp L         &mt LEFT_WIN SEMI       &kp LC(LEFT_ALT)
&kp LSHFT           &kp Z             &kp X               &kp C       &kp V        &kp B        &kp PG_DN  &kp PG_UP  &msc SCRL_DOWN  &msc SCRL_UP  &kp N  &kp M         &mt LCTRL COMMA         &mt LEFT_ALT DOT  &kp LEFT_SHIFT  &none
&kp LC(LEFT_SHIFT)  &mt LCTRL ESCAPE  &mt LALT BACKSPACE  &kp C_MUTE  &lt 1 SPACE  &lt 2 ENTER  &mo 3      &mo 3      &lt 2 ENTER     &lt 1 SPACE   &none  &lm 1 LSHIFT  &mt LC(LEFT_SHIFT) TAB  &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&trans     &kp SLASH         &kp NUMBER_9  &kp NUMBER_8  &kp NUMBER_7  &kp MINUS     &trans     &trans     &trans    &trans    &trans        &trans
&kp BSLH   &kp SINGLE_QUOTE  &kp N6        &kp NUMBER_5  &kp N4        &kp EQUAL     &mkp RCLK  &mkp RCLK  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans             &trans
&kp COMMA  &kp KP_DOT        &kp N3        &kp N2        &kp N1        &kp NUMBER_0  &trans     &trans     &trans    &trans    &trans        &trans     &kp LBKT           &kp RBKT  &trans  &trans
&trans     &trans            &trans        &trans        &trans        &trans        &trans     &trans     &trans    &trans    &trans        &trans     &kp K_APPLICATION  &trans
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp CAPS  &kp F1   &kp F2    &kp F3          &kp F4          &kp F5       &kp F6  &msc SCRL_UP  &kp F8          &mkp MB1        &kp F10       &trans
&kp F11   &kp END  &kp HOME  &msc SCRL_DOWN  &kp PAGE_DOWN   &kp F12      &trans  &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans    &trans
&trans    &trans   &trans    &kp LC(INSERT)  &kp LS(INSERT)  &kp PAGE_UP  &trans  &trans        &trans          &trans          &trans        &trans           &trans    &trans  &trans  &trans
&trans    &trans   &trans    &trans          &trans          &trans       &trans  &trans        &trans          &trans          &trans        &trans           &mkp MB2  &trans
            >;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E  &kp R  &kp T         &kp Y           &M_kp MB3 U       &kp I         &kp O        &kp P       &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D  &kp F  &out OUT_TOG  &mkp LCLK       &mkp LCLK         &out OUT_TOG  &M_kp MB1 J  &kp K       &kp L        &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C  &kp V  &BOT          &msc SCRL_DOWN  &msc SCRL_UP      &none         &none        &BOT        &M_kp MB2 M  &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &none  &mo 2  &kp SPACE     &mkp MB1        &LMouse_sc 0 MB1  &tdRMCLK      &mo 2        &kp C_MUTE  &kp MINUS    &kp EQUAL  &kp GRAVE
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
